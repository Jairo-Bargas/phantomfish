# Copiá este archivo a  deploy/.env  y completá los valores.
#   cp .env.example .env    (en el servidor)

# El nombre por el que se entra a la app (tiene que apuntar a la IP del servidor).
# Con DuckDNS sería algo como:
SITE_ADDRESS=phantomfish.duckdns.org

# Clave para firmar las sesiones. Generá una nueva y pegala acá:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REEMPLAZAR-POR-UNA-CLAVE-LARGA-Y-ALEATORIA

# Contraseña con la que entran Jairo y Sebastián la primera vez.
# (Si ya existe la base con los socios, esto se ignora.)
SEED_PASSWORD=cambiala-por-una-tuya

# Tipo de dólar que se pre-carga en el formulario de pagos.
DEFAULT_RATE_TYPE=blue
