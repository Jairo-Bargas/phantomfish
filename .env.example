# Copiá este archivo a .env y ajustá los valores.

# Clave para firmar las cookies de sesión. Generá una nueva con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-esto-por-una-clave-larga-y-aleatoria

# Base de datos. Por defecto SQLite (archivo local).
# Para PostgreSQL: postgresql+psycopg://usuario:pass@host:5432/phantomfish
DATABASE_URL=sqlite:///./phantomfish.db

# Carpeta donde se guardan los comprobantes subidos (PDF / imágenes).
STORAGE_DIR=./storage/uploads

# Tipo de cotización que se pre-carga en el formulario de pagos.
# Opciones: oficial | blue | mep | ccl | tarjeta | mayorista
DEFAULT_RATE_TYPE=blue

# Contraseña inicial de los dos socios la primera vez que arranca la app.
# Cambiala desde la app apenas entres.
SEED_PASSWORD=phantomfish
